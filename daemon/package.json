{
  "name": "omp-mobile",
  "version": "0.1.0",
  "description": "The computer side of OMP Mobile: runs oh-my-pi sessions and serves them to the phone app over Tailscale.",
  "keywords": [
    "mobile",
    "oh-my-pi",
    "omp",
    "omp-plugin",
    "remote",
    "tailscale"
  ],
  "homepage": "https://github.com/Rinai-R/omp-mobile#readme",
  "bugs": {
    "url": "https://github.com/Rinai-R/omp-mobile/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Rinai",
    "email": "1130157066@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinai-R/omp-mobile.git",
    "directory": "daemon"
  },
  "type": "module",
  "bin": {
    "omp-mobile": "src/server.mjs"
  },
  "omp": {
    "extensions": [
      "./src/omp-extension.mjs"
    ]
  },
  "files": [
    "src",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
