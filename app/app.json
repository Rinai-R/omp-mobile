{
  "expo": {
    "name": "OMP",
    "slug": "omp-mobile",
    "scheme": "omp-mobile",
    "version": "0.4.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "com.rinai.ompmobile",
      "versionCode": 6,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.FOREGROUND_SERVICE_SPECIAL_USE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "splash": {
        "backgroundColor": "#f2f2f3",
        "dark": {
          "backgroundColor": "#000000"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/adaptive-foreground.png",
        "backgroundImage": "./assets/icon/adaptive-background.png",
        "monochromeImage": "./assets/icon/adaptive-monochrome.png"
      }
    },
    "ios": {
      "bundleIdentifier": "com.rinai.ompmobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OMP uses the camera to scan the pairing QR code your computer shows.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Geist-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Geist-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Geist-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMonoNL-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMonoNL-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMonoNL-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Geist-Regular.ttf",
              "./assets/fonts/Geist-Medium.ttf",
              "./assets/fonts/Geist-SemiBold.ttf",
              "./assets/fonts/JetBrainsMonoNL-Regular.ttf",
              "./assets/fonts/JetBrainsMonoNL-Medium.ttf",
              "./assets/fonts/JetBrainsMonoNL-SemiBold.ttf"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "OMP lets you attach photos to a message for the agent.",
          "cameraPermission": "OMP uses the camera to scan the pairing QR code and to take photos you send to the agent.",
          "microphonePermission": false
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#f2f2f3",
      "dark": {
        "backgroundColor": "#000000"
      }
    },
    "icon": "./assets/icon/icon.png"
  }
}
